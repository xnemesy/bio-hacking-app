{
  "expo": {
    "name": "Bio-Hacking",
    "slug": "bio-hacking-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "bundleIdentifier": "com.rocco.biohacking",
      "buildNumber": "4",
      "supportsTablet": false,
      "infoPlist": {
        "NSMotionUsageDescription": "Usato per il feedback tattile del timer recupero",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rocco.biohacking",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": [
        "VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-file-system",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "987db699-0267-4f81-9aef-45d02289fcc6"
      }
    },
    "owner": "xh00k"
  }
}
